<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[4.3.1,)" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[8.0.0,)" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[18.10.1,)" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[8.0.0,)" /> 
        <PackageReference Include="MSTest" Version="[4.4.0,)" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Converter.Generator\Converter.Generator.csproj" />
      <ProjectReference Include="..\Converter\Converter.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- Compositions are compiled by this project and handed to the generator as source code. -->
      <Compile Update="Tests\**\*Composition*.cs">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Compile>
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);RS2008</NoWarn>
        <!-- Packing this as it is would put a lib/net10.0 package on nuget.org that does nothing
             when installed - a generator has to be packed into analyzers/dotnet/cs, and this one
             does not target a framework the compiler can load it from yet. The release workflow
             pushes artifacts/*.nupkg, so the package has to not exist rather than not be pushed. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[4.3.1,)" PrivateAssets="all" />
        <!-- MC0001 is reported by the generator itself, analyzer release tracking is not used here. -->
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="[3.3.3,)">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- The generator resolves the converter interfaces by their real types instead of by name.
             PrivateAssets keeps the reference out of the consumers of the generator - once this
             project is packed as an analyzer, Majipro.Converter.Abstrations.dll has to be packed
             into analyzers/dotnet/cs next to it. -->
        <ProjectReference Include="..\Converter.Abstrations\Converter.Abstrations.csproj" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Majipro.Converter.Generator.Test" />
    </ItemGroup>
</Project>

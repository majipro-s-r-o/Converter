<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PackageProjectUrl>https://github.com/majipro-s-r-o/Converter</PackageProjectUrl>
        <RepositoryUrl>https://github.com/majipro-s-r-o/Converter</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageId>$(ProjectNamePrefix).$(MSBuildProjectName.Replace(" ", "_"))</PackageId>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Converter.Abstrations\Converter.Abstrations.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
      <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

</Project>
